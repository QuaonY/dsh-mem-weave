{
  "name": "dsh-mem-weave",
  "version": "0.7.12",
  "description": "忆织 MemWeave —— 把记忆编织进人格（记忆 × 人格一体 DSH 插件）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "conformance": "node scripts/conformance.mjs --assert-empty",
    "weave": "node scripts/weave.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "persona",
    "memweave"
  ],
  "license": "MIT",
  "author": "Quaon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuaonY/dsh-mem-weave.git"
  },
  "packageManager": "pnpm@11.28.5",
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
